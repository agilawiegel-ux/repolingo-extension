{
  "name": "repolingo-extension",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first, Chinese-optimized translation layer for GitHub.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check:build": "node scripts/verify-build.mjs",
    "size": "node scripts/size-check.mjs",
    "pack": "node scripts/package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:build && npm run pack && npm run size"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.10.0",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.2",
    "linkedom": "^0.18.12",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
